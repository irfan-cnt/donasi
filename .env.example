# Tebar Kebaikan — daftar env. Salin ke .env.local dan isi nilainya.
# JANGAN commit .env.local. Jangan pakai kredensial produksi saat development.
# Variabel NEXT_PUBLIC_* terekspos ke browser: jangan pernah berisi secret.

# --- Wajib (P01) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# UPSTASH_*/QSTASH_*: wajib bila APP_ENV=preview/production; boleh kosong saat development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
AUTH_SECRET=

# --- Aplikasi ---
APP_ENV=
APP_URL=
# Preview saja (Vercel Deployment Protection): diteruskan ke job QStash & uji e2e sandbox. Jangan di production.
VERCEL_AUTOMATION_BYPASS_SECRET=
APP_ENCRYPTION_KEY=

# --- Auth (Google, P04) ---
# Wajib bila APP_ENV=production (AUTH_URL harus https). Kosong di development → tombol Google
# gagal dengan pesan umum; e2e memakai sesi uji dari DB.
# Redirect URI OAuth: <AUTH_URL>/api/auth/callback/google
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Midtrans (Core API) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=
# Opsional, HANYA development/preview (ditolak di production): URL https yang dikirim sebagai
# header X-Override-Notification saat charge, mis. https://<preview>.vercel.app/api/webhooks/midtrans
MIDTRANS_NOTIFICATION_URL_OVERRIDE=

# --- Email (Gmail SMTP, P16) ---
# Wajib di preview/production; development boleh kosong (tes memakai transport palsu).
# GMAIL_APP_PASSWORD = App Password 16 karakter (bukan password akun; wajib 2FA). Server-only.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Pengirim, mis. "Tebar Kebaikan <notifikasi@contoh.id>" (alamat harus GMAIL_USER atau alias terverifikasi)
EMAIL_FROM=
# Penerima alert admin (rekonsiliasi, anomali pembayaran, kuota email)
EMAIL_ADMIN_ALERT=
# Kuota harian (default 500; Workspace ±2000). Alert admin saat > 80%.
EMAIL_DAILY_LIMIT=500
# true agar email benar-benar dikirim; selain itu semua kanal dicatat `skipped`
NOTIFICATIONS_ENABLED=true

# --- WhatsApp (Fonnte) ---
# true = kirim WA (juga butuh platform_settings notifications.whatsapp_enabled=true & opt-in donatur)
WHATSAPP_ENABLED=false
# Token device Fonnte (wajib bila WHATSAPP_ENABLED=true). Rahasia: jangan di-log/commit.
FONNTE_TOKEN=
# Default https://api.fonnte.com/send (harus https)
FONNTE_API_URL=https://api.fonnte.com/send
# Jeda minimal antar pesan WA (ms, global). Default 3000, minimal 1000.
FONNTE_MIN_DELAY_MS=3000

# --- Storage & observability (OD-12, OD-13) ---
BLOB_READ_WRITE_TOKEN=
SENTRY_DSN=

# --- CI/build saja: lewati validasi env (jangan dipakai di runtime produksi) ---
SKIP_ENV_VALIDATION=
