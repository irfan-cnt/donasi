# Tebar Kebaikan — daftar env. Salin ke .env.local dan isi nilainya.
# JANGAN commit .env.local. Jangan pakai kredensial produksi saat development.
# Variabel NEXT_PUBLIC_* terekspos ke browser: jangan pernah berisi secret.

# --- Wajib (P01) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
AUTH_SECRET=

# --- Aplikasi ---
APP_ENV=
APP_URL=
APP_ENCRYPTION_KEY=

# --- Auth (Google) ---
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Midtrans (Core API) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=
MIDTRANS_NOTIFICATION_URL_OVERRIDE=

# --- Email (Gmail SMTP) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
EMAIL_ADMIN_ALERT=
EMAIL_DAILY_LIMIT=
NOTIFICATIONS_ENABLED=

# --- WhatsApp (Fonnte) ---
WHATSAPP_ENABLED=
FONNTE_TOKEN=
FONNTE_API_URL=
FONNTE_MIN_DELAY_MS=

# --- Storage & observability (OD-12, OD-13) ---
BLOB_READ_WRITE_TOKEN=
SENTRY_DSN=

# --- CI/build saja: lewati validasi env (jangan dipakai di runtime produksi) ---
SKIP_ENV_VALIDATION=
